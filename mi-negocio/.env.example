# Copiá este archivo a .env.local y completá los valores.
# Con Supabase local, `npm run db:start` imprime la URL y las claves (también: `npx supabase status`).

# --- Seguras para el navegador (públicas) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave publicable (sb_publishable_...) o la clave anon (JWT) del proyecto.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=reemplazar-con-tu-clave-publicable
# URL pública de la app (se usa en los enlaces de confirmación y recuperación de correo).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solo servidor / scripts de desarrollo (NUNCA en el navegador ni en producción de la app) ---
# La usa únicamente `npm run db:seed` para crear las cuentas de demostración en tu entorno local.
SUPABASE_SECRET_KEY=reemplazar-solo-en-desarrollo-local
# Conexión directa a PostgreSQL local para pruebas de base de datos (npm run test:db).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
